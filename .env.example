# Production secrets are configured with Sites, never in a public client.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
# EXPERT_EMAILS=
OPENAI_MODEL=gpt-4.1-mini
# Enable official public search after applying migrations and completing live QA.
SEUM_LIVE_RESEARCH=false
